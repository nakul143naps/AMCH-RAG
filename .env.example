# ==============================================================================
# AMCH-RAG Environment Configuration
# ==============================================================================

# --- Primary Provider: Google Gemini (Gemini AI Pro Umbrella) ---
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# --- Fallback Providers (100% Free Tiers) ---
# Groq (Ultra-fast fallback): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Broad free model fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# Priority order for LLM gateway failover
PROVIDER_PRIORITY=["gemini", "groq", "openrouter"]

# --- Embeddings & Reranker (100% Free Local fastembed & FlashRank) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# --- Vector Database (Qdrant) ---
# Leave QDRANT_URL empty to use 100% zero-cost local embedded storage (./data/qdrant)
# Or set to http://localhost:6333 if running Qdrant via Docker / Cloud
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=knowledge_base

# --- Cache (Redis / Local SQLite) ---
# Leave REDIS_URL empty to use 100% zero-cost local embedded SQLite cache
# Or set to redis://localhost:6379/0 if running Redis server
REDIS_URL=
LOCAL_CACHE_PATH=./data/cache/cache.db
SEMANTIC_CACHE_THRESHOLD=0.90

# --- Agent Parameters ---
MAX_CORRECTION_ATTEMPTS=2
MAX_GROUNDEDNESS_RETRIES=2
ENABLE_WEB_SEARCH_FALLBACK=true

# --- Web Search (Tavily AI Search: https://tavily.com) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Observability (OpenTelemetry & Langfuse) ---
# Optional: OpenTelemetry OTLP collector endpoint (e.g. http://localhost:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=amch-rag-service

# Optional: Langfuse for LLM cost/latency tracing (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Observability: LangSmith (https://smith.langchain.com) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=AMCH-RAG

